{
  "name": "viewtally",
  "version": "0.1.0",
  "private": true,
  "description": "Wrangler scripts for the viewtally Worker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply viewtally --local",
    "migrate:remote": "wrangler d1 migrations apply viewtally --remote",
    "deploy": "wrangler deploy",
    "test": "cargo test && npm run test:e2e",
    "test:e2e": "node --test \"e2e/*.test.mjs\""
  },
  "devDependencies": {
    "wrangler": "4.156.0"
  }
}
